<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <!-- 仅用于本项目：绕过不可用的公司镜像，从 Maven Central 解析公开依赖。 -->
    <profiles>
        <profile>
            <id>central</id>
            <repositories>
                <repository><id>central</id><url>https://repo.maven.apache.org/maven2</url></repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository><id>central</id><url>https://repo.maven.apache.org/maven2</url></pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles><activeProfile>central</activeProfile></activeProfiles>
</settings>
