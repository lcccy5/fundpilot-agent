APP_ADDR=:8080
REQUEST_TIMEOUT=15s
MAX_MESSAGE_LENGTH=2000
DEFAULT_USER_ID=local-user
SYNC_INTERVAL=12h

# eastmoney：真实公开网页数据；demo：演示数据；http：自定义标准 Provider
FUND_PROVIDER_TYPE=eastmoney
FUND_PROVIDER_BASE_URL=
FUND_PROVIDER_API_KEY=

# 默认零配置 SQLite；生产可改为 mysql
DATABASE_DRIVER=sqlite
DATABASE_DSN=file:data/fund-agent.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
# DATABASE_DRIVER=mysql
# DATABASE_DSN=fund_agent:password@tcp(127.0.0.1:3306)/fund_agent?charset=utf8mb4&parseTime=true

# 可选 Redis。不可用时安全降级到数据库
REDIS_ADDRESS=
REDIS_PASSWORD=
REDIS_DATABASE=0

# 设置后，业务接口需要 Authorization: Bearer <token>
APP_AUTH_TOKEN=

# 上传 PDF 时需要 Apache Tika；TXT/Markdown/HTML 不需要
TIKA_URL=

# 不填 Key 时使用确定性模板回答；填写后调用 OpenAI 兼容的 /chat/completions
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
